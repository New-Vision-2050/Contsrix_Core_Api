							"mode": "raw",
							"raw": "{\n    \"format\": \"xlsx\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/leave-policies/export",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "leave-policies", "export"]
						},
						"description": "Export leave policies to a file (xlsx/csv). Optional filters: name, total_days, day_calculation_type, leave_type_id, ids."
					}
				},
				{
					"name": "Delete Leave Policy",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
