		},
		{
			"key": "auth_token",
			"value": "",
			"description": "Bearer token for authentication - Set this in your environment"
		},
		{
			"key": "language",
			"value": "en",
			"description": "Language for validation messages: 'en' for English, 'ar' for Arabic"
		},
		{
			"key": "country_uuid",
			"value": "01234567-89ab-cdef-0123-456789abcdef",
			"description": "Sample country UUID - Replace with actual country ID"
		},
		{
			"key": "holiday_id",
			"value": "",
			"description": "Public holiday UUID for testing - Set after creating a holiday"
		},
		{
			"key": "leave_type_id",
			"value": "",
