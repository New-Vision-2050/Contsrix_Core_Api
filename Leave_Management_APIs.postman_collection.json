								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "X-Tenant",
								"value": "{{tenant_id}}"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"is_rollover_allowed\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/leave-policies/{{leave_policy_id}}/rollover-allowed",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "leave-policies", "{{leave_policy_id}}", "rollover-allowed"]
						},
						"description": "Toggle rollover-allowed flag on a leave policy."
					}
				},
