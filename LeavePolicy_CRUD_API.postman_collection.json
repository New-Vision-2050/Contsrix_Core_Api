						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies/{{leave_policy_id}}",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies", "{{leave_policy_id}}"]
				},
				"description": "Delete a specific leave policy by UUID."
			}
		}
	],
