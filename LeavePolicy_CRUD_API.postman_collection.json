{
	"info": {
		"_postman_id": "leave-policy-crud-collection",
		"name": "Leave Policy CRUD API",
		"description": "Complete CRUD operations for Leave Policy management.\n\nA leave policy is linked to a leave type via leave_type_id. Whether the \"with balance\" or \"without balance\" field set applies is derived from the linked leave type's is_deduct_from_balance flag.\n\nWith balance (is_deduct_from_balance = true): total_days, min_notice_days, day_calculation_type, entitlement_type, entitlement_start_from, promotion fields, rollover settings, allow_exceed_balance.\nWithout balance (is_deduct_from_balance = false): max_days.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Leave Policies",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies?page={{page}}&per_page={{per_page}}",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies"],
					"query": [
						{
							"key": "page",
							"value": "{{page}}"
						},
						{
							"key": "per_page",
							"value": "{{per_page}}"
						}
					]
				},
				"description": "Retrieve paginated list of leave policies."
			}
		},
		{
			"name": "Get Leave Policy by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies/{{leave_policy_id}}",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies", "{{leave_policy_id}}"]
				},
				"description": "Get a specific leave policy including its linked leave type details."
			}
		},
		{
			"name": "Create Leave Policy (With Balance)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Standard Annual Leave Policy\",\n    \"leave_type_id\": \"{{leave_type_id}}\",\n    \"max_balance_days\": 40,\n    \"total_days\": 21,\n    \"min_notice_days\": 0,\n    \"day_calculation_type\": \"work_day\",\n    \"entitlement_type\": \"upfront\",\n    \"entitlement_start_from\": \"hire_date\",\n    \"promotion_type\": \"after_duration\",\n    \"promotion_duration_months\": 24,\n    \"is_rollover_allowed\": true,\n    \"rollover_duration_months\": 4,\n    \"allow_exceed_balance\": false\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies"]
				},
				"description": "Create a balance-based leave policy (leave type must have is_deduct_from_balance = true).\n\n- name: Policy name (required, max 255 chars, unique per company)\n- leave_type_id: UUID of the leave type (required)\n- max_balance_days: Max balance cap (optional integer, min 0)\n- total_days: Annual entitlement days (required for balance policies)\n- min_notice_days: Min days notice before leave (optional integer, min 0)\n- day_calculation_type: work_day | calendar (required for balance policies)\n- entitlement_type: upfront | monthly (required for balance policies)\n- entitlement_start_from: hire_date (optional)\n- promotion_type: after_duration (optional)\n- promotion_duration_months: required if promotion_type = after_duration\n- is_rollover_allowed: boolean (optional)\n- rollover_duration_months: months rollover balance stays valid (optional integer)\n- allow_exceed_balance: boolean (optional)"
			}
		},
		{
			"name": "Create Leave Policy (Without Balance)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Sick Leave Policy\",\n    \"leave_type_id\": \"{{leave_type_id}}\",\n    \"max_days\": 10\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies"]
				},
				"description": "Create a non-balance leave policy (leave type must have is_deduct_from_balance = false).\n\n- name: Policy name (required, max 255 chars, unique per company)\n- leave_type_id: UUID of the leave type (required)\n- max_days: Maximum leave days balance (required for non-balance policies)"
			}
		},
		{
			"name": "Update Leave Policy",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Enhanced Annual Leave Policy\",\n    \"max_balance_days\": 50,\n    \"total_days\": 25,\n    \"min_notice_days\": 3,\n    \"day_calculation_type\": \"calendar\",\n    \"entitlement_type\": \"monthly\",\n    \"entitlement_start_from\": \"hire_date\",\n    \"promotion_type\": \"after_duration\",\n    \"promotion_duration_months\": 36,\n    \"is_rollover_allowed\": false,\n    \"rollover_duration_months\": null,\n    \"allow_exceed_balance\": true\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies/{{leave_policy_id}}",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies", "{{leave_policy_id}}"]
				},
				"description": "Update an existing leave policy. Note: leave_type_id is immutable after creation."
			}
		},
		{
			"name": "Update Rollover Allowed",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"is_rollover_allowed\": true\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies/{{leave_policy_id}}/rollover-allowed",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies", "{{leave_policy_id}}", "rollover-allowed"]
				},
				"description": "Toggle the rollover-allowed flag on a leave policy."
			}
		},
		{
			"name": "Export Leave Policies",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "X-Tenant",
						"value": "{{tenant_id}}"
					},
					{
						"key": "Accept-Language",
						"value": "{{language}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"format\": \"xlsx\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/leave-policies/export",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "leave-policies", "export"]
				},
				"description": "Export leave policies to a file (xlsx or csv). Optional filters: name, total_days, day_calculation_type, leave_type_id, ids."
			}
		},
		{
			"name": "Delete Leave Policy",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
